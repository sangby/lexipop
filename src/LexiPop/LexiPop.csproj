<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LexiPop</RootNamespace>
    <AssemblyName>LexiPop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lexipop.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Version>0.1.1</Version>
    <Product>LexiPop</Product>
    <AssemblyTitle>LexiPop Dictionary</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同时启用 WPF 与 WinForms 时，去掉 WinForms 的隐式 using，避免 Application / KeyEventArgs 冲突 -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- 词库文件：存在时复制到输出目录 -->
    <None Include="..\..\data\dict.bin"
          Link="dict.bin"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\data\dict.bin')" />
  </ItemGroup>

</Project>
