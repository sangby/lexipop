<Window x:Class="LexiPop.Views.SelectionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">

    <Grid>
        <!-- 按钮态 -->
        <Border x:Name="ButtonState"
                Width="36"
                Height="36"
                CornerRadius="18"
                Background="{DynamicResource ThemeAccent}"
                Cursor="Hand"
                ToolTip="划词翻译"
                MouseLeftButtonUp="OnButtonClicked">
            <TextBlock Text="译"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- 卡片态 -->
        <Border x:Name="CardState"
                Width="340"
                Visibility="Collapsed"
                Style="{StaticResource GlassCardStyle}"
                CornerRadius="{DynamicResource ThemeRadiusLarge}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="SourceText"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeTextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,0,24,0" />
                    <TextBlock Text="✕"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeTextMuted}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Cursor="Hand"
                               MouseLeftButtonUp="OnCloseClicked" />
                </Grid>

                <TextBlock x:Name="BodyText"
                           Grid.Row="1"
                           FontSize="14"
                           Foreground="{DynamicResource ThemeTextSecondary}"
                           TextWrapping="Wrap"
                           LineHeight="24"
                           Margin="0,10,0,0" />

                <StackPanel x:Name="SpeakPanel"
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="0,12,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
