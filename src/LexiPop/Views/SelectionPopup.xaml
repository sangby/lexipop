<Window x:Class="LexiPop.Views.SelectionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">

    <Grid>
        <!-- 按钮态 -->
        <Grid x:Name="ButtonState" Width="44" Height="44">
            <Border Width="36" Height="36" CornerRadius="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Cursor="Hand" ToolTip="划词翻译" MouseLeftButtonUp="OnButtonClicked">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ThemeSelectionButtonBackground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeSelectionButtonBorder}" />
                        <Setter Property="BorderThickness" Value="{DynamicResource ThemeSelectionButtonBorderThickness}" />
                        <Setter Property="Effect" Value="{DynamicResource ThemeSelectionButtonShadow}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSelectionButtonHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="译" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeSelectionButtonForeground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- 卡片态 -->
        <Border x:Name="CardState"
                Width="340"
                Visibility="Collapsed"
                Style="{StaticResource GlassCardStyle}"
                CornerRadius="{DynamicResource ThemeRadiusLarge}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <ScrollViewer x:Name="SourceScroll" Margin="0,0,26,0"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="SourceText"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <Button Content="✕" Width="24" Height="24" Padding="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" Foreground="{DynamicResource ThemeTextMuted}"
                            Cursor="Hand" Click="OnCloseClicked" />
                </Grid>

                <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="BodyText"
                               FontSize="14"
                               Foreground="{DynamicResource ThemeTextSecondary}"
                               TextWrapping="Wrap"
                               LineHeight="24" />
                </ScrollViewer>

                <StackPanel x:Name="SpeakPanel"
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="0,12,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
