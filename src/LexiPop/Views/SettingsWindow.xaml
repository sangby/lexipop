<Window x:Class="LexiPop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="540"
        Height="640"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeWindowSurface}"
            BorderBrush="{DynamicResource ThemeGlassBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="{DynamicResource ThemeGlassSurface}" MouseLeftButtonDown="OnDrag">
                <TextBlock Text="设置"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimary}"
                           Margin="18,14,0,14" />
                <TextBlock Text="✕"
                           FontSize="13"
                           Foreground="{DynamicResource ThemeTextMuted}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0"
                           Cursor="Hand"
                           MouseLeftButtonUp="OnClose" />
            </Grid>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" Margin="18,4,18,8" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="通用" Style="{StaticResource GroupTitle}" />
                    <CheckBox x:Name="AutoStartCheck" Content="开机自启" />
                    <CheckBox x:Name="ShowOnStartupCheck" Content="启动时显示窗口" />

                    <TextBlock Text="外观" Style="{StaticResource GroupTitle}" />
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="OnThemeChanged" />

                    <TextBlock Text="快捷键" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="唤出窗口（点击输入框后按下组合键）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ToggleHotkeyBox" PreviewKeyDown="OnHotkeyKeyDown" />
                    <TextBlock Text="划词翻译" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TranslateHotkeyBox" PreviewKeyDown="OnHotkeyKeyDown" />

                    <TextBlock Text="翻译" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ApiKeyBox" />
                    <TextBlock Text="接口端点（默认 DeepSeek 官方，兼容 OpenAI 格式的服务均可）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="EndpointBox" />
                    <TextBlock Text="模型" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ModelBox" />
                    <CheckBox x:Name="EnableTranslationCheck" Content="启用长句翻译" />

                    <TextBlock Text="划词" Style="{StaticResource GroupTitle}" />
                    <CheckBox x:Name="EnablePopupCheck" Content="启用划词浮窗按钮" />

                    <TextBlock Text="数据" Style="{StaticResource GroupTitle}" />
                    <TextBlock x:Name="DictInfo" Foreground="{DynamicResource ThemeTextMuted}" />
                    <Button x:Name="ClearCacheButton"
                            Content="清除翻译缓存"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Click="OnClearCache" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ThemeGlassSurface}"
                    BorderBrush="{DynamicResource ThemeGlassBorder}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,12">
                    <Button Content="取消" Click="OnCancel" />
                    <Button Content="保存" Click="OnSave"
                            Background="{DynamicResource ThemeAccent}"
                            Foreground="#FFFFFF" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
