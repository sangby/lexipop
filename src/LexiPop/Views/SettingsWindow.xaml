<Window x:Class="LexiPop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="610"
        Height="700"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                            <Grid Margin="1">
                                <TextBlock x:Name="SelectionBox" Margin="8,4,30,4"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" />
                                <TextBox x:Name="PART_EditableTextBox" Margin="7,2,30,2"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         VerticalContentAlignment="Center" Visibility="Hidden" />
                                <ToggleButton x:Name="DropDownToggle" Width="30"
                                              HorizontalAlignment="Right" Focusable="False"
                                              Background="Transparent" BorderThickness="0"
                                              Cursor="Hand"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBlock Text="⌄" Foreground="{DynamicResource ThemeTextSecondary}"
                                           Width="30" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" TextAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=ComboBorder}"
                                        MaxHeight="320">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="False">
                                <Setter TargetName="DropDownToggle" Property="Width" Value="Auto" />
                                <Setter TargetName="DropDownToggle" Property="HorizontalAlignment" Value="Stretch" />
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectionBox" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSurfaceElevated}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccent}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeWindowSurface}"
            BorderBrush="{DynamicResource ThemeGlassBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="{DynamicResource ThemeGlassSurface}" MouseLeftButtonDown="OnDrag">
                <TextBlock Text="设置"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimary}"
                           Margin="18,14,0,14" />
                <Button Content="✕" Width="36" Height="36" Padding="0" Margin="0,0,10,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}"
                        Cursor="Hand" Click="OnClose" />
            </Grid>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" Margin="18,4,18,8" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="通用" Style="{StaticResource GroupTitle}" />
                    <CheckBox x:Name="AutoStartCheck" Content="开机自启" />

                    <TextBlock Text="外观" Style="{StaticResource GroupTitle}" />
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="OnThemeChanged" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="新建主题" Margin="0" Click="OnNewTheme" />
                        <Button Content="编辑主题" Click="OnEditTheme" />
                    </StackPanel>
                    <StackPanel x:Name="ThemeEditor" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="CSS 主题变量（保存到本机 themes 目录）"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ThemeCssBox" Height="270"
                                 FontFamily="Consolas" FontSize="12"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="保存主题" Margin="0" Click="OnSaveTheme" />
                            <Button Content="收起编辑器" Click="OnCloseThemeEditor" />
                        </StackPanel>
                        <TextBlock x:Name="ThemeStatus" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource ThemeTextMuted}" />
                    </StackPanel>

                    <TextBlock Text="快捷键" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="设置方法：点输入框，按组合键，再点“保存”。使用时无需打开设置。"
                               TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="划词翻译" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TranslateHotkeyBox" PreviewKeyDown="OnHotkeyKeyDown" />
                    <TextBlock Text="结果小窗（按一次隐藏，再按一次恢复）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="RecallHotkeyBox" PreviewKeyDown="OnHotkeyKeyDown" />

                    <TextBlock Text="翻译" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="模型提供方" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ProviderCombo" SelectionChanged="OnProviderChanged" />
                    <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ApiKeyBox"
                             ToolTip="可留空并使用 LEXIPOP_API_KEY 环境变量；环境变量优先于此处。" />
                    <TextBlock Text="聊天接口端点" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="EndpointBox" />
                    <TextBlock Text="模型列表端点（自定义服务可修改）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ModelListEndpointBox" />
                    <TextBlock Text="模型（可直接输入模型 ID）" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button x:Name="FetchModelsButton" DockPanel.Dock="Right"
                                Content="抓取模型" Click="OnFetchModels" />
                        <ComboBox x:Name="ModelCombo" IsEditable="True" />
                    </DockPanel>
                    <TextBlock x:Name="ModelFetchStatus" TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeTextMuted}" Margin="0,5,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox x:Name="EnableTranslationCheck" Content="启用长句翻译" />
                        <Button Content="？" Width="24" Height="24" Padding="0" Margin="8,3,0,0"
                                ToolTip="了解长句翻译" Click="OnLongTextHelp" />
                    </StackPanel>

                    <TextBlock Text="划词" Style="{StaticResource GroupTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="EnablePopupCheck" Content="启用划词翻译" />
                        <Button Content="？" Width="24" Height="24" Padding="0" Margin="8,3,0,0"
                                ToolTip="了解划词翻译" Click="OnSelectionHelp" />
                    </StackPanel>

                    <TextBlock Text="数据" Style="{StaticResource GroupTitle}" />
                    <TextBlock x:Name="DictInfo" Foreground="{DynamicResource ThemeTextMuted}" />
                    <Button x:Name="ClearCacheButton"
                            Content="清除翻译缓存"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Click="OnClearCache" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ThemeGlassSurface}"
                    BorderBrush="{DynamicResource ThemeGlassBorder}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,12">
                    <Button Content="取消" Click="OnCancel" />
                    <Button Content="保存" Click="OnSave"
                            Background="{DynamicResource ThemeAccent}"
                            Foreground="#FFFFFF" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
